ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
EMBEDDER=local
LLM_PROVIDER=anthropic
# Google Gemini credentials and model (used when LLM_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated providers to try after the primary provider.
LLM_FALLBACK_PROVIDERS=
RETRIEVAL_K=5
RERANK_DEFAULT=false
LOG_LEVEL=INFO
EDGAR_IDENTITY=Your Name your.email@example.com